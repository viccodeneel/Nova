# ============================================================================
# NOVA Intelligence OS - Environment Variables
# Copy to .env and configure for your local or cloud environment.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO SOURCE CONTROL.
# ============================================================================

# PORT: Server listening port (default: 3000)
PORT=3000

# DATABASE_URL: PostgreSQL or Supabase Connection String
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres
# Leave empty to run in standalone in-memory repository mode
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nova_terminal"

# DB_SSL: Set to 'true' for Supabase / Cloud SQL managed instances, 'false' for local dev
DB_SSL="true"

# MT5_BRIDGE_SECRET: Pre-shared key for authenticating incoming MT5 sync requests
MT5_BRIDGE_SECRET="YOUR_SECURE_RANDOM_BRIDGE_SECRET"
SYNC_INTERVAL_SECONDS=10
HISTORY_SYNC_INTERVAL_SECONDS=300

# Dashboard sign-in (set both in Render; use a strong unique password)
NOVA_AUTH_PASSWORD="YOUR_UNIQUE_DASHBOARD_PASSWORD"
NOVA_AUTH_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"

# Configure these in the local connector environment, never in the frontend.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SIMULATION_MODE=false
MT5_CONNECTOR_HOST="127.0.0.1"
MT5_CONNECTOR_PORT=5001

# MT5_CONNECTOR_URL: Address where the Python MT5 desktop connector service is running
MT5_CONNECTOR_URL=

# NOVA_BACKEND_URL: Public backend URL used by the local MT5 connector to push snapshots
NOVA_BACKEND_URL="https://YOUR_RENDER_SERVICE.onrender.com"

# CORS_ORIGIN: Frontend origin allowed to call this backend
CORS_ORIGIN="https://viccodeneel.github.io"

# NOVA_AI_PROVIDER: 'anthropic' or 'gemini'. If unset, NOVA uses whichever provider has an API key.
# Gemini has a free tier (key from Google AI Studio, no billing needed; free-tier prompts may be used by Google to improve its products).
NOVA_AI_PROVIDER="anthropic"

# ANTHROPIC_API_KEY: Backend-only key for Claude text reasoning and read-only tool calls
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# CLAUDE_MODEL: Optional Anthropic model override
CLAUDE_MODEL="claude-sonnet-4-6"

# Gemini remains available by setting NOVA_AI_PROVIDER="gemini"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# APP_URL: Base URL where this terminal applet is hosted
APP_URL="http://localhost:3000"

# --- NOVA world access (optional) ---
# Web search via Tavily: free plan = 1,000 credits/month, no card (tavily.com). A basic search costs 1 credit.
TAVILY_API_KEY=""
# Max web searches per UTC day (protects the free monthly quota)
NOVA_SEARCH_DAILY_LIMIT="30"
# City used when you ask about the weather without naming one (weather uses Open-Meteo, no key needed)
NOVA_DEFAULT_LOCATION=""
