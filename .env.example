# ============================================================================
# NOVA Intelligence OS - Environment Variables
# Copy to .env and configure for your local or cloud environment.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO SOURCE CONTROL.
# ============================================================================

# PORT: Server listening port (default: 3000)
PORT=3000

# DATABASE_URL: PostgreSQL or Supabase Connection String
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres
# Leave empty to run in standalone in-memory repository mode
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nova_terminal"

# DB_SSL: Set to 'true' for Supabase / Cloud SQL managed instances, 'false' for local dev
DB_SSL="true"

# MT5_BRIDGE_SECRET: Pre-shared key for authenticating incoming MT5 sync requests
MT5_BRIDGE_SECRET="YOUR_SECURE_RANDOM_BRIDGE_SECRET"

# Configure these in the local connector environment, never in the frontend.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SIMULATION_MODE=false
MT5_CONNECTOR_HOST="127.0.0.1"
MT5_CONNECTOR_PORT=5001

# MT5_CONNECTOR_URL: Address where the Python MT5 desktop connector service is running
MT5_CONNECTOR_URL=

# NOVA_BACKEND_URL: Public backend URL used by the local MT5 connector to push snapshots
NOVA_BACKEND_URL="https://YOUR_RENDER_SERVICE.onrender.com"

# CORS_ORIGIN: Frontend origin allowed to call this backend
CORS_ORIGIN="https://viccodeneel.github.io"

# GEMINI_API_KEY: Required for future Gemini AI cognitive auditor features
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL where this terminal applet is hosted
APP_URL="http://localhost:3000"
